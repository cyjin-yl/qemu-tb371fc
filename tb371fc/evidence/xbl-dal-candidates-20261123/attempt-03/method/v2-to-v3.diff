+            record_va = struct_base + index * stride
+            row = {
+                "layout": label, "entry_stride": stride,
+                "record_va": record_va, "pointer_offset": pointer_offset,
+                "layout_selected": False, "native_build_flag_proven": False,
+                "target_contents_decoded": False, "array_total_length_known": False,
+            }
+            try:
+                row["record_mapping"] = self.view.describe(
+                    record_va, stride, scoped=True, file_backed=True)
+                raw = self.view.read(record_va, stride)
+                if pointer_offset:
+                    row["declared_size"] = struct.unpack_from("<I", raw, 0)[0]
+                    row["declared_size_is_array_total_length"] = False
+                    row["declared_size_note"] = (
+                        "The source generator can emit sizeof(void*); this is not a table count.")
+                target = struct.unpack_from("<Q", raw, pointer_offset)[0]
+                need(target != 0, "null_structure_target")
+                # An unmapped value from the alternate layout is not exported.
+                row["target"] = self.view.describe(target)
+                row["pointer_slot"] = self.view.describe(
+                    record_va + pointer_offset, 8, scoped=True, file_backed=True)
+                row["status"] = "slot_and_target_mapping_observed"
