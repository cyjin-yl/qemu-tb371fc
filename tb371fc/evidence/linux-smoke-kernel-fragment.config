# SPDX-License-Identifier: GPL-2.0-or-later
# Input for KCONFIG_ALLCONFIG + allnoconfig, upstream Linux 6.12.114.
# Exercise the complete 8 GiB / eight-CPU machine with an external initramfs.
CONFIG_LOCALVERSION="-tb371fc-qemu-smoke"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARCH_QCOM=y
CONFIG_OF=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_COMMON_CLK=y
# GENI probe uses OPP clock helpers even without an OPP DT table.
# PM_OPP has no prompt; the generic devfreq core selects it in upstream Kconfig.
CONFIG_PM=y
CONFIG_PM_DEVFREQ=y
CONFIG_PM_OPP=y
CONFIG_QCOM_GENI_SE=y
CONFIG_TTY=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RODATA_FULL_DEFAULT_ENABLED=y
# CONFIG_MODULES is not set
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_FTRACE is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCOV is not set
# CONFIG_PROFILING is not set
# CONFIG_GCOV_KERNEL is not set
# CONFIG_KALLSYMS is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_SECURITY is not set
# CONFIG_AUDIT is not set
